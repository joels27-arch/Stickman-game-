{
  "name": "tumble-royale",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Tumble Royale — a 3D multiplayer obstacle-course party game (up to 30 players)",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "tsx watch server/node-main.ts",
    "dev:client": "vite",
    "build": "vite build && node scripts/build-server.mjs",
    "start": "node dist/server/node-main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:load": "tsx tests/load.ts",
    "test:e2e": "node tests/e2e.mjs"
  },
  "dependencies": {
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@fontsource/lilita-one": "^5.3.0",
    "@fontsource/nunito": "^5.2.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.186.0",
    "@types/ws": "^8.5.13",
    "esbuild": "^0.28.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.186.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
