// Cloudflare Workers deployment (one Durable Object class plays room, directory and profile roles).
//   npm run build && npm run build:cf && npx wrangler deploy
{
  "name": "tumble-royale",
  "main": "dist/worker/index.js",
  "compatibility_date": "2025-05-01",
  "assets": { "directory": "./dist/client", "binding": "ASSETS", "not_found_handling": "single-page-application" },
  "durable_objects": { "bindings": [{ "name": "ROOMS", "class_name": "Room" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }]
}
